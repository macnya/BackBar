# Copy to .env.local for local development. Never commit real credentials.
# For a Supabase/Vercel deployment, use the Transaction pooler URL (port 6543).
DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<URL_ENCODED_DB_PASSWORD>@<POOLER_HOST>:6543/postgres?sslmode=require

# Used only by Drizzle Kit for schema changes. Prefer Supabase Session pooler (port 5432).
# If omitted, Drizzle Kit falls back to DATABASE_URL.
DRIZZLE_DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<URL_ENCODED_DB_PASSWORD>@<POOLER_HOST>:5432/postgres?sslmode=require

# Generate a unique value with: openssl rand -base64 32
AUTH_SECRET=
